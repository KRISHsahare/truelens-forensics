# Copy to `.env` in this directory (`backend/.env`) for local runs. Every key below is a field of
# `app.config.Settings`, read case-insensitively; the value shown is the default unless noted.
#
# Nothing secret belongs in `.env` except `OVERLAY_SIGNING_KEY`, and `.env` is not committed. On
# Render that key goes into the service's environment, not into the repository.

# --- identity ------------------------------------------------------------------
APP_NAME=TrueLens
# `prod` turns on the startup validations: a signing key is required, the cache TTL must be shorter
# than the overlay TTL, and a wide web concurrency with the in-memory store is refused.
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Structured JSON lines, which is what a log aggregator actually parses.
LOG_JSON=false

# --- network -------------------------------------------------------------------
HOST=0.0.0.0
# Render injects PORT; leave this unset locally and pass --port to uvicorn instead.
# PORT=8000
# The browser calls this service directly — there is no same-origin proxy, because a proxy would
# buffer a 10 MB upload against a 10 MB default limit. This origin is the CORS allowlist entry.
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated additions for preview deployments: https://pr-42.truelens.app
EXTRA_CORS_ORIGINS=
# Behind a proxy that *overwrites* X-Forwarded-For (Render, nginx with proxy_set_header). A client
# can send any header it likes, so leaving this false is the safe default: without a trusted proxy
# every address would choose its own rate-limit bucket.
TRUST_PROXY=false

# --- upload limits -------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
# Decoded-pixel ceiling. `Image.MAX_IMAGE_PIXELS` equivalent: a 200-megapixel file is refused before
# it is turned into an array, because the alternative is an OOM that kills the worker pool.
MAX_ANALYSIS_PIXELS=60000000
ANALYSIS_MAX_DIM=2048
NATIVE_MAX_DIM=2560
ALLOWED_FORMATS=image/jpeg,image/png,image/webp,image/bmp

# --- performance ---------------------------------------------------------------
# One of: dev-12core | render-2cpu | render-1cpu. The preset fills the knobs below that you leave
# unset; a value you set explicitly always wins over the preset. `render-1cpu` also drops CNN_TTA and
# the JPEG-ghost tile count, which is the difference between finishing and timing out on a free tier.
PERF_PROFILE=dev-12core
# POOL_MAX_WORKERS=8
# ANALYZER_PARALLEL=true
# TORCH_THREADS=0
# GHOST_TILES=3
# COPY_MOVE_FEATURES=3000
# CNN_TTA=true
# GRADCAM_MIN_AI_SCORE=0.45
# OVERLAY_MAX_DIM=1280
# MAX_CONCURRENT_JOBS=4
# JOB_SOFT_DEADLINE_S=6
# JOB_HARD_DEADLINE_S=12
# Uvicorn workers. More than 1 with the in-memory store is refused at startup in prod, because a job
# created in worker A is invisible to worker B — set STORE_BACKEND=redis first.
WEB_CONCURRENCY=1

# --- model artifacts -----------------------------------------------------------
# Resolved against the working directory, then backend/artifacts, then the repository root.
CNN_WEIGHTS_PATH=artifacts/model.pt
FUSION_PATH=artifacts/fusion.joblib
METRICS_PATH=artifacts/metrics.json
CLIP_PROBE_PATH=artifacts/clip_probe.joblib
# Needs `pip install -e .[clip]` and ~900 MB of ViT-L/14 weights on first use. Off by default: the
# probe is a second opinion, not a dependency, and the CNN technique records NaN when it is absent.
ENABLE_CLIP_PROBE=false
YUNET_MODEL_PATH=app/ml/models/face_detection_yunet_2023mar.onnx

# --- storage and lifecycle -----------------------------------------------------
# Empty means the system temp directory. Overlays are written here and swept with the job.
SCRATCH_ROOT=
JOB_TTL_S=600
OVERLAY_TTL_S=600
# Must stay strictly below OVERLAY_TTL_S: a cache entry that outlives the PNGs it points at hands out
# URLs that 410. Validated in prod.
RESULT_CACHE_TTL_S=540
RESULT_CACHE_MAX_ENTRIES=256
SWEEPER_INTERVAL_S=30
# memory | redis. memory is one process only; redis is what makes more than one web worker possible.
STORE_BACKEND=memory
REDIS_URL=
# JOB_STORE_MAX_ENTRIES=512

# --- security ------------------------------------------------------------------
# HMAC key for the signed overlay URLs. Required when ENVIRONMENT=prod. Generate one and keep it out
# of the repository:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OVERLAY_SIGNING_KEY=
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_JOBS=200/minute
RATE_LIMIT_BATCH=5/minute
# Strip camera GPS and personal names from the *returned* metadata view. The analysed copy keeps
# everything — EXIF is evidence — but the response and the PDF do not carry a location.
REDACT_PII=true
BATCH_MAX_IMAGES=20
